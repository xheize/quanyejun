/frontend/.vinext/
/frontend/.wrangler/
/frontend/dist/
/frontend/coverage/
/frontend/out/
*.tsbuildinfo
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

