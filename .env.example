# Web
NEXT_PUBLIC_RUNTIME_URL=http://localhost:8080

# Go runtime
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://quanyejun:quanyejun@localhost:5432/quanyejun?sslmode=disable
# User-facing self name. Internal identity remains identity_quanyejun.
IDENTITY_DISPLAY_NAME=QuanYejun

# Provider selection: auto | local | claude-api | claude-code | openai-api | codex-cli | builtin
LLM_PROVIDER=auto
LLM_PROVIDER_PRIORITY=local,claude-api,claude-code,openai-api,codex-cli,builtin

# Local OpenAI-compatible model. If omitted in auto mode, running Ollama
# (localhost:11434) and LM Studio (localhost:1234) are probed for loaded models.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=1024

# Claude Code CLI (must be installed, runnable, and authenticated)
CLAUDE_CODE_PATH=claude
CLAUDE_CODE_MODEL=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Backward-compatible alias for OPENAI_MODEL
LLM_MODEL=

# Codex CLI (must be installed, runnable, and authenticated)
CODEX_CLI_PATH=codex
CODEX_MODEL=
