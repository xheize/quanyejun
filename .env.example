# Web: empty = preview without API/WebSocket requests. Set before building.
# Local development: NEXT_PUBLIC_RUNTIME_URL=http://localhost:8080
NEXT_PUBLIC_RUNTIME_URL=

# Go runtime
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://quanyejun:quanyejun@localhost:5432/quanyejun?sslmode=disable
# User-facing self name. Internal identity remains identity_quanyejun.
IDENTITY_DISPLAY_NAME=QuanYejun

# Existing SSO: https://sso.example.com (enable both issuer and client ID together).
# Verify discovery first: this alias advertised https://sso-dev.example.com on 2026-09-13.
# The configured issuer must exactly match discovery; aliases are rejected.
# Register the exact callback URI, authorization_code grant, code response,
# openid scope and S256 PKCE in the SSO admin UI. Never put the secret in NEXT_PUBLIC_*.
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URL=http://localhost:8080/auth/callback
WEB_PUBLIC_URL=http://localhost:3000
# Optional base64-encoded 32-byte key; share across backend replicas.
# Empty: generate and persist <QUANYEJUN_HOME>/session.key (keep this volume).
SESSION_ENCRYPTION_KEY=

# Replaceable execution environment. These default to .runtime/* locally.
QUANYEJUN_ENVIRONMENT_KIND=local
QUANYEJUN_ENVIRONMENT_PROFILE=developer
QUANYEJUN_RUNTIME_ROOT=.runtime
QUANYEJUN_HOME=
QUANYEJUN_WORKSPACE=
QUANYEJUN_CONFIG_DIR=
QUANYEJUN_CACHE_DIR=
# Local SKILL.md packages. Defaults to <config>/skills when empty.
QUANYEJUN_SKILLS_DIR=
# Capability and authority are separate. Adding shell exposes environment_exec
# to the model; use it only when this process runs inside the intended computer boundary.
QUANYEJUN_AUTHORITY_MODE=internal-only
QUANYEJUN_ENVIRONMENT_ALLOW=shell,read-files,write-files

# Agent Harness execution budgets.
QUANYEJUN_AGENT_MAX_TURNS=8
QUANYEJUN_AGENT_MAX_TOOL_CALLS=24
QUANYEJUN_AGENT_RUN_TIMEOUT_SECONDS=300

# Administrator-owned MCP server inventory and parent/admin authority grants.
# Defaults to <config>/mcp-servers.json and <config>/mcp-authority.json.
QUANYEJUN_MCP_SERVERS_FILE=
QUANYEJUN_MCP_AUTHORITY_FILE=
QUANYEJUN_MCP_REFRESH_SECONDS=30
# Example secret referenced by config/mcp-servers.example.json.
EXAMPLE_MCP_AUTHORIZATION=

# API provider selection: openai | anthropic | local | builtin
# Production should select one provider explicitly. builtin is development-only.
LLM_PROVIDER=builtin

# Local OpenAI-compatible HTTP model. Set both provider and model explicitly.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=1024

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_STORE=false
# Backward-compatible alias for OPENAI_MODEL
LLM_MODEL=
