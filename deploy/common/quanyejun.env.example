# Copy to /etc/quanyejun/config.env inside the LXC guest.
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
IDENTITY_DISPLAY_NAME=QuanYejun

# Persistent computer environment inside a dedicated guest. shell exposes
# environment_exec; the provided LXC service permits guest-level package installs.
QUANYEJUN_ENVIRONMENT_KIND=lxc
QUANYEJUN_ENVIRONMENT_PROFILE=server
QUANYEJUN_RUNTIME_ROOT=/var/lib/quanyejun
QUANYEJUN_HOME=/var/lib/quanyejun/home
QUANYEJUN_WORKSPACE=/var/lib/quanyejun/workspace
QUANYEJUN_CONFIG_DIR=/etc/quanyejun
QUANYEJUN_CACHE_DIR=/var/cache/quanyejun
QUANYEJUN_SKILLS_DIR=/etc/quanyejun/skills
QUANYEJUN_AUTHORITY_MODE=internal-only
QUANYEJUN_ENVIRONMENT_ALLOW=shell,read-files,write-files
QUANYEJUN_AGENT_MAX_TURNS=8
QUANYEJUN_AGENT_MAX_TOOL_CALLS=24
QUANYEJUN_AGENT_RUN_TIMEOUT_SECONDS=300
QUANYEJUN_MCP_SERVERS_FILE=/etc/quanyejun/mcp-servers.json
QUANYEJUN_MCP_AUTHORITY_FILE=/etc/quanyejun/mcp-authority.json
QUANYEJUN_MCP_REFRESH_SECONDS=30

# Add DATABASE_URL and provider credentials locally. Never commit real secrets.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STORE=false
