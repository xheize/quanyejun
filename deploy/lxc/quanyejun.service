[Unit]
Description=QuanYejun persistent identity runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# This profile treats the dedicated LXC guest as the security boundary. Root is
# intentional so the assigned computer can install and use guest OS packages.
User=root
Group=root
WorkingDirectory=/var/lib/quanyejun/workspace
EnvironmentFile=-/etc/quanyejun/config.env
ExecStart=/usr/local/bin/quanyejun-runtime
Restart=on-failure
RestartSec=3
UMask=0027

PrivateTmp=true

[Install]
WantedBy=multi-user.target
